# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Провайдер LLM: anthropic | openai | ollama | mock
LLM_PROVIDER=mock

# Ключи API (нужен только ключ выбранного провайдера)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Модели
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1-mini
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434

# Лимиты и защита от зацикливания
MAX_STEPS=30
MAX_REVISIONS=2
TASK_TIMEOUT_SEC=600
LLM_TIMEOUT_SEC=60
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=8000
# Базовая пауза (сек) между повторными попытками; растёт экспоненциально: 1, 2, 4...
RETRY_BASE_SEC=1

# Хранилища
DB_PATH=data/state.db
LOG_DIR=logs
OUTPUT_DIR=outputs
CHROMA_DIR=data/chroma

# Эмбеддинги для векторного поиска:
#   auto — пробуем sentence-transformers, при недоступности модели переходим на hashing
#   sentence-transformers — только нейросетевая модель (нужен интернет при первом запуске)
#   hashing — простой офлайн-эмбеддер (хеширование символьных триграмм)
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# OpenAlex API — реальные публикационные показатели для реалистичных целевых значений KPI
OPENALEX_ENABLED=true
# E-mail для «вежливого» пула OpenAlex (рекомендуется, необязательно)
OPENALEX_EMAIL=
# Ключ API OpenAlex (необязательно)
OPENALEX_API_KEY=
OPENALEX_COUNTRY=RU
OPENALEX_TIMEOUT_SEC=15
OPENALEX_MAX_RETRIES=2
OPENALEX_CACHE_DAYS=30
OPENALEX_CACHE_PATH=data/cache/openalex.json

# Куда веб-интерфейс сохраняет загруженные файлы
UPLOAD_DIR=data/uploads
